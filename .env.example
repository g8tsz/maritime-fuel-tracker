# SQLite (default). For Postgres: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/dev.db
# Required in production: long random secret for session signing.
SESSION_SECRET=change-me-in-production-use-long-random-string
# Optional: POST /api/internal/jobs/drain
INTERNAL_JOB_SECRET=

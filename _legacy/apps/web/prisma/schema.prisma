generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Top-level tenant (single-tenant can use one org).
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sites     Site[]
  users     User[]
  customers Customer[]
  vessels   Vessel[]
  contracts Contract[]
}

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  timezone       String       @default("UTC")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  stations       Station[]
  berthLines     BerthLine[]
  deliveries     Delivery[]
  memberships    Membership[]
  edgeDevices    EdgeDevice[]
  fuelHubs       FuelHub[]
}

/// Billable / metering "station" (e.g. pier manifold). Typically 1:1 with a berth line in early deployments.
model Station {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code        String
  displayName String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  berthLines  BerthLine[]
  deliveries  Delivery[]
  rollups     StationMetricRollup[]
  jobs        JobQueue[]
  errorLogs   ApplicationErrorLog[]
  fuelHubs    FuelHub[]

  @@unique([siteId, code])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  displayName    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships         Membership[]
  auditEvents         AuditEvent[]         @relation("ActorAuditEvents")
  calibrationRecords  CalibrationRecord[]
}

enum Role {
  IT_ADMIN
  ORG_ADMIN
  SITE_SUPERVISOR
  OPERATOR
  FINANCE
  CUSTOMER_VIEWER
}

/// Per-site role; CUSTOMER_VIEWER may be org-wide with siteId null (read all sites in org).
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
}

model FuelGrade {
  id          String     @id @default(cuid())
  code        String     @unique
  description String
  sulfurPct   Float?
  createdAt   DateTime   @default(now())
  deliveries  Delivery[]
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  billingEmail   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contracts      Contract[]
  deliveries     Delivery[]
  invoices       Invoice[]
}

model Vessel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  imoNumber      String?
  name           String
  flag           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deliveries     Delivery[]
}

model BerthLine {
  id          String        @id @default(cuid())
  siteId      String
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stationId   String
  station     Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  name        String
  maxRateM3h  Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  meter       MeterProfile?
  deliveries  Delivery[]
  fuelHubs    FuelHub[]
}

enum MeteringMode {
  MANUAL
  MASS_CORIOLIS
  VOLUME_TEMP_CORRECTED
  SIMULATED_MODBUS
  /// Non-invasive clamp-on ultrasonic (FuelTrace-class); same software path as other fieldbuses.
  CLAMP_ON_ULTRASONIC
}

model MeterProfile {
  id               String         @id @default(cuid())
  berthLineId      String         @unique
  berthLine        BerthLine      @relation(fields: [berthLineId], references: [id], onDelete: Cascade)
  mode             MeteringMode
  /// JSON: register map, scaling, units, opc node ids, etc.
  integrationJson String        @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  readings         MeasurementReading[]
  calibrations     CalibrationRecord[]
}

model EdgeDevice {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  apiKeyHash String
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  hub       FuelHub?
}

/// Field gateway / “FuelTrace Hub” — one logical pump manifold and its sensor stack.
model FuelHub {
  id               String      @id @default(cuid())
  siteId           String
  site             Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stationId        String?
  station          Station?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  berthLineId      String?
  berthLine        BerthLine?  @relation(fields: [berthLineId], references: [id], onDelete: SetNull)
  code             String
  displayName      String
  firmwareVersion  String?
  edgeDeviceId     String?     @unique
  edgeDevice       EdgeDevice? @relation(fields: [edgeDeviceId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sensors          HubSensor[]

  @@unique([siteId, code])
}

enum HubSensorKind {
  FLOW_CLAMP_ON_ULTRASONIC
  TEMP_PIPE_CLAMP
  VIBRATION_PIPE
  TANK_LEVEL_ULTRASONIC
  PRESSURE_CLAMP_ON
}

model HubSensor {
  id           String        @id @default(cuid())
  hubId        String
  hub          FuelHub       @relation(fields: [hubId], references: [id], onDelete: Cascade)
  kind         HubSensorKind
  label        String?
  channelIndex Int           @default(0)
  installJson  String        @default("{}")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// K-factor / reference calibration for a meter profile (audit trail).
model CalibrationRecord {
  id             String       @id @default(cuid())
  meterProfileId String
  meterProfile   MeterProfile @relation(fields: [meterProfileId], references: [id], onDelete: Cascade)
  kFactor        Decimal
  referenceNote  String       @default("")
  createdAt      DateTime     @default(now())
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

enum DeliveryStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  RECONCILED
  DISPUTED
}

enum PricingBasis {
  PER_MT
  PER_M3_AT_15C
  PER_M3_AT_DELIVERY_TEMP
}

model Contract {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title          String
  currency       String       @default("USD")
  basis          PricingBasis
  unitPrice      Decimal
  taxRate        Decimal      @default(0)
  roundingKg     Int          @default(1) /// commercial rounding step for mass (kg)
  roundingM3     Int          @default(3) /// decimal places for volume
  /// Ship vs meter variance band before auto-accept (kg); disputes above this.
  reconVarianceKg Decimal     @default(500)
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deliveries     Delivery[]
}

model Delivery {
  id             String          @id @default(cuid())
  siteId         String
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stationId      String
  station        Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)
  berthLineId    String
  berthLine      BerthLine       @relation(fields: [berthLineId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vesselId       String?
  vessel         Vessel?         @relation(fields: [vesselId], references: [id])
  fuelGradeId    String
  fuelGrade      FuelGrade       @relation(fields: [fuelGradeId], references: [id])
  contractId     String?
  contract       Contract?       @relation(fields: [contractId], references: [id])
  status         DeliveryStatus  @default(DRAFT)
  startedAt      DateTime?
  endedAt        DateTime?
  /// Totalizer-style opening reading (SI); null until first edge sample arms the baseline.
  meterStartMassKg   Decimal?
  meterStartVolumeM3 Decimal?
  /// Closing totalizer snapshot when available (optional until stop/disconnect workflow).
  meterStopMassKg   Decimal?
  meterStopVolumeM3 Decimal?
  /// Last cumulative reading from the field device (for audit / BDN trace).
  edgeLastCumulativeMassKg   Decimal?
  edgeLastCumulativeVolumeM3 Decimal?
  /// Raw custody totals (unrounded), SI units
  rawMassKg      Decimal?
  rawVolumeM3    Decimal?
  avgTempC       Decimal?
  densityKgM3    Decimal?
  vcfStandard    String?
  /// Commercial billable after rounding rules
  commercialMassKg   Decimal?
  commercialVolumeM3 Decimal?
  /// Pre-delivery estimate
  estMassKg      Decimal?
  estVolumeM3    Decimal?
  estCost        Decimal?
  /// FuelTrace / BDN: gross metered before hose correction (optional).
  grossMeteredMassKg   Decimal?
  /// Mass in transfer hose (not in vessel tank); subtracted for net delivered.
  lineContentsMassKg   Decimal?
  /// Hose geometry for line-contents model (SI).
  hoseLengthM          Float?
  hoseInnerDiameterMm  Float?
  /// 0–100 composite anomaly score (higher = more review).
  anomalyScore         Int?
  anomalyFactorsJson   String         @default("{}")
  zeroVerificationPassedAt DateTime?
  zeroDriftKgPerHr     Decimal?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  readings       MeasurementReading[]
  bdn            BunkerDeliveryNote?
  invoiceLines   InvoiceLine[]
  reconCase      ReconciliationCase?
  preFlightItems DeliveryPreFlightItem[]
}

model MeasurementReading {
  id             String       @id @default(cuid())
  deliveryId     String
  delivery       Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  meterProfileId String?
  meterProfile   MeterProfile? @relation(fields: [meterProfileId], references: [id])
  observedAt     DateTime
  massKg         Decimal?
  massRateKgs    Decimal?
  volumeM3       Decimal?
  volumeRateM3s  Decimal?
  tempC          Decimal?
  densityKgM3    Decimal?
  /// Ultrasonic / hub QoS 0–100 when provided by edge.
  signalQuality  Int?
  pressureBar    Decimal?
  tankLevelM     Decimal?
  pumpRunning    Boolean?
  source         String       /// manual, edge_sim, opcua, modbus
  rawPayloadJson String       @default("{}")
  createdAt      DateTime     @default(now())
}

/// Operator pre-bunker checklist (FuelTrace-style); created when bunkering starts.
model DeliveryPreFlightItem {
  id           String    @id @default(cuid())
  deliveryId String
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  key          String
  label        String
  required     Boolean   @default(true)
  completedAt  DateTime?
  evidenceNote String?
  createdAt    DateTime  @default(now())

  @@unique([deliveryId, key])
}

model BunkerDeliveryNote {
  id          String   @id @default(cuid())
  deliveryId String   @unique
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  number      String   @unique
  pdfBlob     Bytes?
  signedBySupplier String?
  signedByReceiver String?
  signedAt    DateTime?
  createdAt   DateTime @default(now())
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Invoice {
  id          String        @id @default(cuid())
  customerId String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  number      String        @unique
  status      InvoiceStatus @default(DRAFT)
  currency    String
  subtotal    Decimal
  tax         Decimal
  total       Decimal
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lines       InvoiceLine[]
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliveryId  String   @unique
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal
  unit        String
  unitPrice   Decimal
  lineTotal   Decimal
}

/// Prevents replayed edge POST bodies from duplicating readings when `Idempotency-Key` is reused.
model EdgeIdempotencyRecord {
  key        String   @id
  deliveryId String
  createdAt  DateTime @default(now())
}

enum ReconciliationStatus {
  OPEN
  ACCEPTED
  DISPUTED
}

model ReconciliationCase {
  id               String               @id @default(cuid())
  deliveryId       String               @unique
  delivery         Delivery             @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  shipReportedMassKg Decimal?
  varianceKg         Decimal?
  status             ReconciliationStatus @default(OPEN)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorAuditEvents", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  payload   String   @default("{}")
  correlationId String?
  createdAt DateTime @default(now())
}

enum RollupGranularity {
  HOUR
  DAY
}

model StationMetricRollup {
  id             String             @id @default(cuid())
  stationId      String
  station        Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  granularity    RollupGranularity
  deliveryCount  Int                @default(0)
  errorCount     Int                @default(0)
  totalRawMassKg Decimal?
  totalRawVolumeM3 Decimal?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([stationId, periodStart, granularity])
}

enum JobType {
  STATION_ROLLUP_HOUR
  STATION_ROLLUP_DAY
  ROLLING_RESTART_EDGE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model JobQueue {
  id             String    @id @default(cuid())
  organizationId String?
  stationId      String?
  station        Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  type           JobType
  payload        String    @default("{}")
  status         JobStatus @default(PENDING)
  runAfter       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ApplicationErrorLog {
  id             String   @id @default(cuid())
  correlationId  String?
  code           String
  siteId         String?
  stationId      String?
  station        Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  deliveryId     String?
  edgeDeviceId   String?
  httpStatus     Int?
  message        String
  details        String   @default("{}")
  createdAt      DateTime @default(now())
}
